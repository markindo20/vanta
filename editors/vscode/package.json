{
  "name": "vanta-language",
  "displayName": "Vanta",
  "description": "Vanta language support: diagnostics, completion, hover, definitions, document symbols, and native debugging.",
  "version": "0.7.0",
  "publisher": "vanta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markindo20/vanta"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vanta",
    "language server",
    "lsp",
    "debugger",
    "dap"
  ],
  "activationEvents": [
    "onLanguage:vanta",
    "onDebugResolve:vanta"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vanta",
        "aliases": [
          "Vanta",
          "vanta"
        ],
        "extensions": [
          ".vnt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vanta-light.png",
          "dark": "./icons/vanta.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vanta",
        "scopeName": "source.vanta",
        "path": "./syntaxes/vanta.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Vanta",
      "properties": {
        "vanta.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `vanta` executable or a Python interpreter. Leave empty to detect `vanta` on PATH, a workspace virtualenv, or a Python environment with the `compiler` package installed."
        },
        "vanta.debug.gdbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a GDB executable for debugging. Leave empty to use `VANTA_GDB`, a GDB beside the C++ compiler, a WinLibs/MSYS2 installation, or `gdb` on PATH. Vanta debug builds use DWARF, so a GCC or Clang toolchain is required."
        }
      }
    },
    "debuggers": [
      {
        "type": "vanta",
        "label": "Vanta",
        "languages": [
          "vanta"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Vanta source file to debug.",
                "default": "${workspaceFolder}/game.vnt"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments passed to the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugged program.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first line of the Vanta main function.",
                "default": false
              },
              "gdbPath": {
                "type": "string",
                "description": "Optional GDB executable overriding vanta.debug.gdbPath."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "vanta",
            "request": "launch",
            "name": "Debug Vanta Program",
            "program": "${workspaceFolder}/game.vnt",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Vanta: Debug Program",
            "description": "Launch and debug a Vanta source file.",
            "body": {
              "type": "vanta",
              "request": "launch",
              "name": "Debug Vanta Program",
              "program": "${workspaceFolder}/game.vnt",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vanta.restartServer",
        "title": "Vanta: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
