# Vanta + SDL2: play a synthesized tone with the raw C API, no game kit.
#
#   python main.py run examples/sdl_audio.vnt --lib-dir C:/msys64/mingw64/lib --link SDL2
#
# The program builds an SDL_AudioSpec by hand, opens the default device
# with a null callback (the queue API), generates 100 ms of a 440 Hz
# square wave in its arena, queues it, and waits for the device to play
# it out. There is no window at all — audio only — and under the dummy
# audio driver (SDL_AUDIODRIVER=dummy) the device plays to nowhere in
# real time, which is how the test suite runs this headless.

struct SDL_AudioSpec:
    freq: i32
    format: u16
    channels: u8
    silence: u8
    samples: u16
    padding: u16
    size: u32
    callback: func(ptr<void>, ptr<u8>, i32)
    userdata: ptr<void>

extern "sdl2" {
    func SDL_Init(flags: u32) -> i32
    func SDL_Quit() -> void
    func SDL_OpenAudioDevice(device: ptr<u8>, iscapture: i32, desired: ptr<SDL_AudioSpec>,
                             obtained: ptr<SDL_AudioSpec>, allowed_changes: i32) -> u32
    func SDL_QueueAudio(dev: u32, data: ptr<void>, len: i32) -> i32
    func SDL_GetQueuedAudioSize(dev: u32) -> u32
    func SDL_PauseAudioDevice(dev: u32, pause_on: i32) -> void
    func SDL_CloseAudioDevice(dev: u32) -> void
    func SDL_Delay(ms: u32) -> void
}

const SDL_INIT_AUDIO: u32 = 16
const AUDIO_S16SYS: u16 = 32784    # AUDIO_S16SYS, 0x8010, on little-endian hosts

func main() -> void:
    if SDL_Init(SDL_INIT_AUDIO) != 0:
        print_str("SDL_Init failed")
        return
    let arena = Arena(16384)
    let desired = arena.alloc::<SDL_AudioSpec>(1)
    let obtained = arena.alloc::<SDL_AudioSpec>(1)
    desired[0] = SDL_AudioSpec(
        freq: 44100, format: AUDIO_S16SYS, channels: 1, silence: 0,
        samples: 1024, padding: 0, size: 0,
        callback: ptr_null::<func(ptr<void>, ptr<u8>, i32)>(),
        userdata: ptr_null::<void>())
    let dev = SDL_OpenAudioDevice(ptr_null::<u8>(), 0, desired, obtained, 0)
    print_fmt("opened {}", dev != 0)
    if dev == 0:
        print_str("SDL_OpenAudioDevice failed")
        SDL_Quit()
        return
    print_fmt("rate {} channels {}", obtained[0].freq, obtained[0].channels)

    # 100 ms of a 440 Hz square wave: half the period up, half down.
    let n = obtained[0].freq / 10
    let period = obtained[0].freq / 440
    let wave = arena.alloc::<i16>(n)
    for i in range(0, n):
        if (i / period) % 2 == 1:
            wave[i] = -8000
        else:
            wave[i] = 8000
    print_fmt("queued {}", SDL_QueueAudio(dev, wave, n * 2) == 0)

    SDL_PauseAudioDevice(dev, 0)       # devices start out paused
    mut guard = 0
    while SDL_GetQueuedAudioSize(dev) > 0 and guard < 2000:
        SDL_Delay(5)
        guard += 1
    print_fmt("drained {}", SDL_GetQueuedAudioSize(dev) == 0)

    SDL_CloseAudioDevice(dev)
    SDL_Quit()
