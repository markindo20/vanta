extern "sdl2" {
    func SDL_Init(flags: u32) -> i32
    func SDL_Quit() -> void
    func SDL_CreateWindow(title: str, x: i32, y: i32, w: i32, h: i32, flags: u32) -> ptr<void>
    func SDL_DestroyWindow(window: ptr<void>) -> void
    func SDL_CreateRenderer(window: ptr<void>, index: i32, flags: u32) -> ptr<void>
    func SDL_DestroyRenderer(renderer: ptr<void>) -> void
    func SDL_SetRenderDrawColor(renderer: ptr<void>, r: i32, g: i32, b: i32, a: i32) -> i32
    func SDL_RenderClear(renderer: ptr<void>) -> i32
    func SDL_RenderFillRect(renderer: ptr<void>, rect: ptr<i32>) -> i32
    func SDL_RenderPresent(renderer: ptr<void>) -> void
    func SDL_PollEvent(event: ptr<i32>) -> i32
}

const WIN_W: i32 = 640
const WIN_H: i32 = 480
const EV_QUIT: i32 = 256
const EV_KEYDOWN: i32 = 768
const EV_KEYUP: i32 = 769
const KEY_LEFT: i32 = 1073741904
const KEY_RIGHT: i32 = 1073741903
const KEY_ESCAPE: i32 = 27

func main() -> void:
    if SDL_Init(32) != 0:
        print_str("SDL_Init failed")
        return
    let window = SDL_CreateWindow("Vanta: catch the coins", 100, 100, WIN_W, WIN_H, 4)
    if ptr_is_null(window):
        print_str("SDL_CreateWindow failed")
        SDL_Quit()
        return
    mut renderer = SDL_CreateRenderer(window, -1, 6)   # accelerated + vsync
    if ptr_is_null(renderer):
        renderer = SDL_CreateRenderer(window, -1, 0)   # any renderer (software, headless)
    if ptr_is_null(renderer):
        print_str("SDL_CreateRenderer failed")
        SDL_DestroyWindow(window)
        SDL_Quit()
        return
    let arena = Arena(4096)
    let rect = arena.alloc::<i32>(4)
    let ev = arena.alloc::<i32>(16)

    mut px = 288.0
    mut left_down = false
    mut right_down = false
    mut cx = 320.0
    mut cy = 0.0
    mut score = 0
    mut misses = 0
    mut running = true
    mut frames = 0
    mut max_frames = 0
    if arg_count() > 1:
        max_frames = str_to_i32(arg_str(1))

    while running:
        while SDL_PollEvent(ev) == 1:
            let t = ev[0]
            if t == EV_QUIT:
                running = false
            elif t == EV_KEYDOWN or t == EV_KEYUP:
                let down = t == EV_KEYDOWN
                let sym = ev[5]
                if sym == KEY_LEFT:
                    left_down = down
                elif sym == KEY_RIGHT:
                    right_down = down
                elif sym == KEY_ESCAPE and down:
                    running = false

        if left_down:
            px -= 6.0
        if right_down:
            px += 6.0
        if px < 0.0:
            px = 0.0
        if px > i32_to_f32(WIN_W) - 64.0:
            px = i32_to_f32(WIN_W) - 64.0

        cy += 3.0
        if cy > i32_to_f32(WIN_H):
            misses += 1
            if misses >= 3:
                running = false
            cy = 0.0
            cx = rand_f32() * (i32_to_f32(WIN_W) - 16.0)
        if cy + 16.0 > 440.0 and cy < 452.0 and cx + 16.0 > px and cx < px + 64.0:
            score += 1
            cy = 0.0
            cx = rand_f32() * (i32_to_f32(WIN_W) - 16.0)

        SDL_SetRenderDrawColor(renderer, 18, 18, 28, 255)
        SDL_RenderClear(renderer)
        rect[0] = f32_to_i32(px)
        rect[1] = 440
        rect[2] = 64
        rect[3] = 12
        SDL_SetRenderDrawColor(renderer, 80, 220, 120, 255)
        SDL_RenderFillRect(renderer, rect)
        rect[0] = f32_to_i32(cx)
        rect[1] = f32_to_i32(cy)
        rect[2] = 16
        rect[3] = 16
        SDL_SetRenderDrawColor(renderer, 240, 200, 60, 255)
        SDL_RenderFillRect(renderer, rect)
        SDL_RenderPresent(renderer)

        frames += 1
        if max_frames > 0 and frames >= max_frames:
            running = false

    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
    print_fmt("score {} misses {}", score, misses)
