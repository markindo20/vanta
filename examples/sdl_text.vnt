# Vanta + SDL2 + SDL_ttf: draw text with the raw C API, no game kit.
# Close the window (or press Esc) to quit.
#
#   python main.py run examples/sdl_text.vnt --lib-dir C:/msys64/mingw64/lib --link SDL2_ttf --link SDL2
#
# Optional argument: a frame limit, so the same binary can run a quick
# headless smoke test without a display:
#
#   set SDL_VIDEODRIVER=dummy
#
# The font is the tiny one the game kit ships; any TrueType file works.

struct SDL_Color:
    r: u8
    g: u8
    b: u8
    a: u8

extern "sdl2" {
    func SDL_Init(flags: u32) -> i32
    func SDL_Quit() -> void
    func SDL_CreateWindow(title: str, x: i32, y: i32, w: i32, h: i32, flags: u32) -> ptr<void>
    func SDL_DestroyWindow(window: ptr<void>) -> void
    func SDL_CreateRenderer(window: ptr<void>, index: i32, flags: u32) -> ptr<void>
    func SDL_DestroyRenderer(renderer: ptr<void>) -> void
    func SDL_SetRenderDrawColor(renderer: ptr<void>, r: i32, g: i32, b: i32, a: i32) -> i32
    func SDL_RenderClear(renderer: ptr<void>) -> i32
    func SDL_CreateTextureFromSurface(renderer: ptr<void>, surface: ptr<void>) -> ptr<void>
    func SDL_RenderCopy(renderer: ptr<void>, texture: ptr<void>, src: ptr<i32>, dst: ptr<i32>) -> i32
    func SDL_RenderPresent(renderer: ptr<void>) -> void
    func SDL_PollEvent(event: ptr<i32>) -> i32
    func SDL_FreeSurface(surface: ptr<void>) -> void
    func SDL_DestroyTexture(texture: ptr<void>) -> void
}

extern "sdl2_ttf" {
    func TTF_Init() -> i32
    func TTF_Quit() -> void
    func TTF_OpenFont(path: str, ptsize: i32) -> ptr<void>
    func TTF_CloseFont(font: ptr<void>) -> void
    func TTF_SizeUTF8(font: ptr<void>, text: str, w: ptr<i32>, h: ptr<i32>) -> i32
    func TTF_RenderUTF8_Blended(font: ptr<void>, text: str, color: SDL_Color) -> ptr<void>
}

const EV_QUIT: i32 = 256        # SDL_QUIT
const EV_KEYDOWN: i32 = 768     # SDL_KEYDOWN
const KEY_ESCAPE: i32 = 27      # SDLK_ESCAPE

# One scratch block holds everything a draw needs: [0] width, [1] height,
# [2..5] the source rect, [6..9] the destination rect.
func draw_text(renderer: ptr<void>, font: ptr<void>, scratch: ptr<i32>, txt: str, x: i32, y: i32) -> void:
    TTF_SizeUTF8(font, txt, scratch, ptr_offset(scratch, 1))
    let color = SDL_Color(r: 240, g: 240, b: 210, a: 255)
    let surface = TTF_RenderUTF8_Blended(font, txt, color)
    if ptr_is_null(surface):
        return
    let texture = SDL_CreateTextureFromSurface(renderer, surface)
    SDL_FreeSurface(surface)
    if ptr_is_null(texture):
        return
    let src = ptr_offset(scratch, 2)
    src[0] = 0
    src[1] = 0
    src[2] = scratch[0]
    src[3] = scratch[1]
    let dst = ptr_offset(scratch, 6)
    dst[0] = x
    dst[1] = y
    dst[2] = scratch[0]
    dst[3] = scratch[1]
    SDL_RenderCopy(renderer, texture, src, dst)
    SDL_DestroyTexture(texture)

func main() -> void:
    if SDL_Init(32) != 0:           # SDL_INIT_VIDEO
        print_str("SDL_Init failed")
        return
    let window = SDL_CreateWindow("Vanta text", 100, 100, 480, 320, 4)
    if ptr_is_null(window):
        print_str("SDL_CreateWindow failed")
        SDL_Quit()
        return
    mut renderer = SDL_CreateRenderer(window, -1, 6)   # accelerated + vsync
    if ptr_is_null(renderer):
        renderer = SDL_CreateRenderer(window, -1, 0)   # any renderer (headless)
    if ptr_is_null(renderer):
        print_str("SDL_CreateRenderer failed")
        SDL_DestroyWindow(window)
        SDL_Quit()
        return
    TTF_Init()
    let font = TTF_OpenFont("examples/gamekit/fonts/tom-thumb.ttf", 32)
    if ptr_is_null(font):
        print_str("TTF_OpenFont failed")
        SDL_DestroyRenderer(renderer)
        SDL_DestroyWindow(window)
        TTF_Quit()
        SDL_Quit()
        return

    let arena = Arena(512)
    let scratch = arena.alloc::<i32>(10)
    let ev = arena.alloc::<i32>(16)
    mut running = true
    mut frames = 0
    mut max_frames = 0
    if arg_count() > 1:
        max_frames = str_to_i32(arg_str(1))

    while running:
        while SDL_PollEvent(ev) == 1:
            let t = ev[0]
            if t == EV_QUIT:
                running = false
            elif t == EV_KEYDOWN and ev[5] == KEY_ESCAPE:
                running = false
        SDL_SetRenderDrawColor(renderer, 30, 90, 160, 255)
        SDL_RenderClear(renderer)
        draw_text(renderer, font, scratch, "Vanta + SDL_ttf", 40, 40)
        SDL_RenderPresent(renderer)
        frames += 1
        if max_frames > 0 and frames >= max_frames:
            running = false

    TTF_CloseFont(font)
    TTF_Quit()
    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
    print_fmt("frames {}", frames)
