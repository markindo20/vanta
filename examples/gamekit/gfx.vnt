# gamekit/gfx.vnt — rectangle drawing helpers built on an SDL renderer.
#
# SDL_RenderFillRect wants a pointer to a four-i32 SDL_Rect. Every helper
# here takes one as `rect`, so a game allocates it once at startup and
# reuses it:
#
#   let arena = Arena(512)
#   let rect = arena.alloc::<i32>(4)
#   gfx_fill_rect(screen, rect, 10, 10, 40, 20, 240, 240, 240)
#
# Textures — loading image files and drawing sprites — live in
# gamekit/image.vnt, next to their SDL2_image dependency.

import "sdl.vnt"

func gfx_clear(s: Screen, cr: i32, cg: i32, cb: i32) -> void:
    SDL_SetRenderDrawColor(s.renderer, cr, cg, cb, 255)
    SDL_RenderClear(s.renderer)

func gfx_fill_rect(s: Screen, rect: ptr<i32>, x: i32, y: i32, w: i32, h: i32, cr: i32, cg: i32, cb: i32) -> void:
    # Draws one filled rectangle in the given colour; alpha is opaque.
    SDL_SetRenderDrawColor(s.renderer, cr, cg, cb, 255)
    rect[0] = x
    rect[1] = y
    rect[2] = w
    rect[3] = h
    SDL_RenderFillRect(s.renderer, rect)

func gfx_stroke_rect(s: Screen, rect: ptr<i32>, x: i32, y: i32, w: i32, h: i32, t: i32, cr: i32, cg: i32, cb: i32) -> void:
    # An outline of thickness t, drawn as four thin filled rectangles.
    gfx_fill_rect(s, rect, x, y, w, t, cr, cg, cb)
    gfx_fill_rect(s, rect, x, y + h - t, w, t, cr, cg, cb)
    gfx_fill_rect(s, rect, x, y, t, h, cr, cg, cb)
    gfx_fill_rect(s, rect, x + w - t, y, t, h, cr, cg, cb)

func gfx_present(s: Screen) -> void:
    SDL_RenderPresent(s.renderer)
