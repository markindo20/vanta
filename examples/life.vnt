# Conway's Game of Life on a 40x20 torus.
#
# Vanta has no 2D arrays, so the grid is flattened: index = y * W + x.
# Two patterns are seeded: a glider (which travels) and a blinker (which
# oscillates in place). Both preserve their cell counts, so the final grid
# always contains exactly 8 live cells.
#
# The final generation is drawn with '#' (alive) and '.' (dead), which is only
# possible because write_str does not append a newline.

const W: i32 = 40
const H: i32 = 20
const STEPS: i32 = 10

func idx(x: i32, y: i32) -> i32:
    return y * W + x

func wrap(v: i32, n: i32) -> i32:
    mut r = v
    if r < 0:
        r += n
    if r >= n:
        r -= n
    return r

func neighbours(grid: ptr<i32>, x: i32, y: i32) -> i32:
    mut n = 0
    for dy in range(-1, 2):
        for dx in range(-1, 2):
            if dx == 0 and dy == 0:
                continue
            n += grid[idx(wrap(x + dx, W), wrap(y + dy, H))]
    return n

func main() -> void:
    let arena = Arena(65536)
    let a = arena.alloc::<i32>(W * H)
    let b = arena.alloc::<i32>(W * H)
    for i in range(0, W * H):
        a[i] = 0
        b[i] = 0

    # glider
    a[idx(1, 0)] = 1
    a[idx(2, 1)] = 1
    a[idx(0, 2)] = 1
    a[idx(1, 2)] = 1
    a[idx(2, 2)] = 1

    # blinker
    a[idx(20, 5)] = 1
    a[idx(21, 5)] = 1
    a[idx(22, 5)] = 1

    for step in range(0, STEPS):
        for y in range(0, H):
            for x in range(0, W):
                let n = neighbours(a, x, y)
                mut alive = 0
                if a[idx(x, y)] == 1:
                    if n == 2 or n == 3:
                        alive = 1
                else:
                    if n == 3:
                        alive = 1
                b[idx(x, y)] = alive
        for i in range(0, W * H):
            a[i] = b[i]

    # draw the final generation
    for y in range(0, H):
        for x in range(0, W):
            if a[idx(x, y)] == 1:
                write_str("#")
            else:
                write_str(".")
        print_newline()
