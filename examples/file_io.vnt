# file_io.vnt — reading and writing files.
#
# Usage:
#   python main.py run examples/file_io.vnt <path>
#
# Reads <path>, writes a copy next to it as <path>.copy, and reports the
# byte counts. file_read returns an owned string, so the contents stay
# valid for as long as they are reachable. file_exists tells a missing
# file apart from an empty one (both read back as "").

func main() -> void:
    if arg_count() < 2:
        print_str("usage: file_io <path>")
        print_newline()
        return

    let path = arg_str(1)
    if not file_exists(path):
        print_fmt("no such file: {}", path)
        return

    let contents = file_read(path)
    print_fmt("read {} bytes from {}", str_len(contents), path)

    let copy_path = str_concat(path, ".copy")
    let written = file_write(copy_path, contents)
    if written < 0:
        print_fmt("could not write {}", copy_path)
        return
    print_fmt("wrote {} bytes to {}", written, copy_path)
