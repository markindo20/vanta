# Arrays + Quat/Matrix4 math demo

func sum_array(xs: [i32, 4]) -> i32:
    mut total = 0
    for i in range(0, len(xs)):
        total += xs[i]
    return total

func main() -> void:
    let xs: [i32, 4] = [10, 20, 30, 40]
    print_i32(len(xs))
    print_i32(sum_array(xs))
    print_i32(xs[0])
    print_i32(xs[3])

    mut counts = [1, 2, 3, 4]
    counts[0] += 100
    print_i32(counts[0])

    # Identity quaternion leaves vec unchanged
    let q = Quat(0.0, 0.0, 0.0, 1.0)
    let v = Vec3(1.0, 2.0, 3.0)
    let r = q * v
    print_f32(r.x)
    print_f32(r.y)
    print_f32(r.z)

    # Identity matrix * vec
    let m = Matrix4()
    let r2 = m * v
    print_f32(r2.x)

    # Matrix4 * Matrix4 (identity * identity = identity)
    let m2 = m * m
    let r3 = m2 * v
    print_f32(r3.y)

    # Trig: a 45-degree unit vector, and its heading back via atan2.
    let angle = 0.7853982            # pi/4 as f32
    let dir = Vec2(cos_f32(angle), sin_f32(angle))
    print_f32(dir.x)
    print_f32(dir.y)
    print_f32(atan2_f32(dir.y, dir.x))